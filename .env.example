# MongoDB Connection URI (Local MongoDB or MongoDB Atlas)
# Default fallback to local MongoDB instance
MONGODB_URI=mongodb://127.0.0.1:27017/prescription_db

# Google Gemini API Key for AI Clinical Chatbot
# Optional: The system automatically includes an intelligent clinical fallback engine if this key is not provided
GEMINI_API_KEY=

# Server Port (default 3001)
PORT=3001
